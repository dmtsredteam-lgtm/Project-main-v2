# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.codex-dev*.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
# NOT /dist/ — this is a Vite project, not Next.js, and dist/ here is the
# committed, pre-built SOC wall (see root README: "dist/ is committed
# pre-built" so the booth needs no rebuild toolchain). That line was stale
# boilerplate and silently made every rebuilt asset file untracked — the
# cause of a real, live bug: a fresh clone got an index.html referencing
# hashed asset files that git had never actually stored.
/.wrangler/
/outputs/
/work/
