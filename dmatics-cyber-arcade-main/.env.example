# Copy to .env.local (or set these in the Vercel project) — neither is committed.

# Credentials for the booth leaderboard reset. Unset, that endpoint is disabled.
ADMIN_USER=
ADMIN_PASSWORD=

# Baked into the deploy so tablets do not need ?hub= on the URL.
NEXT_PUBLIC_GISEC_HUB=

# --- Clearing every board from this arcade's one button ----------------------
# Only needed when the arcade runs on its OWN Next.js server (npm start, or
# Vercel). When the hub is serving the arcade at http://<hub>:7788/arcade the
# button talks to the hub instead, and these are set on the hub.
#
# ADMIN_TOKEN must be the SAME value on the arcade, the hub and the challenge.
ADMIN_TOKEN=
GISEC_HUB=http://127.0.0.1:7788
REDTEAM_URL=http://127.0.0.1:8000
