# Copy to .env and fill in. .env is gitignored.

# Flask session key. Both gunicorn workers must share one, or sessions break.
#   openssl rand -hex 32
SECRET_KEY=

# Arena Hub address — the machine driving the SOC wall. Use its LAN address,
# NOT localhost: this runs inside a container, where localhost is the container.
# Leave blank and the challenge runs standalone with nothing on the big screen.
HUB_URL=http://192.168.1.50:7788

# Must match ADMIN_TOKEN on the Arena Hub. Leave both blank for a plain booth
# LAN; set both to lock down the endpoint that can end a visitor's run.
HUB_TOKEN=
