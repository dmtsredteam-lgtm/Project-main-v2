# Copy to .env and fill in. .env is gitignored.

# Token for POST /api/admin/reset, which wipes the arena leaderboard.
# Unset, that endpoint is disabled.
#   openssl rand -hex 24
ADMIN_TOKEN=

# Optional: where to serve the wall and arcade from.
# WALL_DIR=../soc-wall-main/dist
# ARCADE_DIR=../dmatics-cyber-arcade-main/public

# --- Clearing every board from the arcade's one button ----------------------
# At the booth the iPad opens http://<hub>:7788/arcade, which is a static file —
# so the button's POST lands on THIS service, not on a Next.js API. These three
# are what let the hub answer it and clear the red team's board as well as its
# own. Leave them unset and the button refuses and says why.
#
# ADMIN_USER / ADMIN_PASSWORD must match what the crew types into the panel.
# ADMIN_TOKEN must be the SAME value on the hub, the challenge and the arcade.
ADMIN_USER=
ADMIN_PASSWORD=
REDTEAM_URL=http://127.0.0.1:8000
